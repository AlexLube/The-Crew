# Puerto de la API
PORT=4000
# Fichero de la base de datos SQLite (en un volumen persistente en producción)
DB_PATH=data/the-crew.db
# Orígenes web permitidos (separados por comas). Vacío = todos.
CORS_ORIGIN=
# Primer usuario de marketing en un despliegue nuevo
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Destinatarios de los avisos
EMAIL_MARKETING=marketing@issaline.com
EMAIL_ALMACEN=almacen@issaline.com
EMAIL_FROM="The Crew <thecrew@issaline.com>"
# SMTP. Sin SMTP_HOST los emails solo se guardan en la base de datos y se muestran en consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
